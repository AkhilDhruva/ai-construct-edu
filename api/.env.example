# Copy to api/.env for local runs. Every setting is MANTLE_<NAME> (see mantle_api/settings.py).

# Local: SQLite, deterministic mock model, development sign-in.
MANTLE_ENV=dev
MANTLE_DATABASE_URL=sqlite:///./mantle.db
MANTLE_MODEL_MODE=mock
MANTLE_AUTH_MODE=dev

# Live model: Claude through the Anthropic SDK. Credentials come from the environment
# (ANTHROPIC_API_KEY, or an `ant auth login` profile) and are never stored here.
# MANTLE_MODEL_MODE=live
# MANTLE_MODEL_PRIMARY=claude-sonnet-5-5
# MANTLE_MODEL_STANDBY=claude-haiku-4-5
# MANTLE_DAILY_TOKEN_BUDGET=200000

# Postgres (Supabase or RDS). Run `uv run python -m mantle_api.migrate` as the owner first,
# then connect the API as a login role that is a member of mantle_app (row-level security).
# MANTLE_DATABASE_URL=postgresql+psycopg://mantle_api:...@db.example.supabase.co:5432/postgres

# Supabase Auth (asymmetric signing keys): verify tokens against the project's JWKS.
# MANTLE_AUTH_MODE=jwks
# MANTLE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# MANTLE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
# MANTLE_ADMIN_SUBS=["<your auth user id>"]

# Telemetry: OTLP over HTTP, for example to Langfuse.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 public:secret>
