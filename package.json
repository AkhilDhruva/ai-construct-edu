{
  "name": "veraclause-mantle",
  "private": true,
  "version": "0.1.0",
  "description": "VeraClause Mantle — AI Construct Education. A governed, offline-first portal that teaches agentic AI system design one interactive lab per concept.",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --port 4317 --strictPort",
    "typecheck": "node node_modules/typescript/bin/tsc -b",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "e2e": "node node_modules/@playwright/test/cli.js test",
    "ci": "npm run lint && npm run typecheck && npm run validate:content && npm run test && npm run build && npm run e2e"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "dexie": "^4.4.6",
    "framer-motion": "^14.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "ts-fsrs": "^5.4.2",
    "ulid": "^3.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
